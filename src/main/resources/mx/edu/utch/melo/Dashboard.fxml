<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.melo.controller.DashboardController"
            prefWidth="1280" prefHeight="960"
            style="-fx-background-color: #FDF5EF;">

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox prefWidth="228" prefHeight="960"
              style="-fx-background-color: #2C1A0E; -fx-padding: 0;">

            <!-- Logo area -->
            <VBox alignment="CENTER" style="-fx-padding: 24 20 20 20; -fx-background-color: #1E1208;">
                <Label text="melo" style="-fx-text-fill: #FFFFFF; -fx-font-size: 22; -fx-font-weight: BOLD;"/>
                <Label text="Terminal 01" style="-fx-text-fill: #9A8070; -fx-font-size: 12;"/>
            </VBox>

            <!-- Nav items -->
            <VBox style="-fx-padding: 20 12 0 12; -fx-spacing: 4;">
                <Button text="Orders" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #C0A898; -fx-font-size: 14; -fx-padding: 10 16; -fx-cursor: HAND;"/>
                <Button text="Tables" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #C0A898; -fx-font-size: 14; -fx-padding: 10 16; -fx-cursor: HAND;"/>
                <Button text="Menu" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #C0A898; -fx-font-size: 14; -fx-padding: 10 16; -fx-cursor: HAND;"/>
                <Button text="Reports" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #C0A898; -fx-font-size: 14; -fx-padding: 10 16; -fx-cursor: HAND;"/>
                <Button text="Inventory" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #C0A898; -fx-font-size: 14; -fx-padding: 10 16; -fx-cursor: HAND;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom: Settings -->
            <VBox style="-fx-padding: 0 12 24 12; -fx-spacing: 4;">
                <Button text="Settings" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #C0A898; -fx-font-size: 14; -fx-padding: 10 16; -fx-cursor: HAND;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox prefHeight="64" alignment="CENTER_LEFT"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E8DDD5; -fx-border-width: 0 0 1 0; -fx-padding: 0 24;">
            <Label text="Melo POS" style="-fx-font-size: 20; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Search -->
            <TextField promptText="Search..." prefWidth="260"
                       style="-fx-background-color: #F5EDE6; -fx-background-radius: 20; -fx-border-color: transparent; -fx-padding: 8 16; -fx-font-size: 13;"/>
            <HBox.margin><Insets left="16"/></HBox.margin>
            <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: HAND; -fx-padding: 0 8;"/>
            <Button text="👤" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: HAND; -fx-padding: 0 8;"/>
        </HBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <VBox style="-fx-padding: 48 48 0 48; -fx-spacing: 32;">

            <!-- Greeting -->
            <VBox spacing="6">
                <Label text="Good Morning, Terminal 01"
                       style="-fx-font-size: 36; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
                <Label text="Select a mode to begin operations."
                       style="-fx-font-size: 14; -fx-text-fill: #888888;"/>
            </VBox>

            <!-- Top row: Comedor (large) + Domicilio -->
            <HBox spacing="20" HBox.hgrow="ALWAYS">

                <!-- Comedor card (large) -->
                <VBox prefWidth="600" prefHeight="280"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E8DDD5; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <Label text="🪑" style="-fx-font-size: 28; -fx-text-fill: #C8552A;"/>
                    <VBox.margin><Insets bottom="16"/></VBox.margin>
                    <Label text="Comedor"
                           style="-fx-font-size: 26; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
                    <Label text="Manage dine-in orders, table assignments, and floor plan."
                           style="-fx-font-size: 13; -fx-text-fill: #888888; -fx-wrap-text: true;" maxWidth="320"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Open Floor Plan"
                            style="-fx-background-color: #1A1A1A; -fx-text-fill: #FFFFFF; -fx-font-size: 13; -fx-font-weight: BOLD; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: HAND;"/>
                </VBox>

                <!-- Domicilio card -->
                <VBox prefWidth="280" prefHeight="280"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E8DDD5; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <!-- Badge -->
                    <HBox alignment="TOP_RIGHT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="3 Active"
                               style="-fx-background-color: #F4E4D8; -fx-text-fill: #C8552A; -fx-font-size: 11; -fx-font-weight: BOLD; -fx-background-radius: 20; -fx-padding: 4 10;"/>
                    </HBox>
                    <Label text="🛵" style="-fx-font-size: 26; -fx-text-fill: #C8552A;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Domicilio"
                           style="-fx-font-size: 20; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
                    <Label text="Delivery &amp; Takeout"
                           style="-fx-font-size: 12; -fx-text-fill: #888888;"/>
                </VBox>
            </HBox>

            <!-- Bottom row: 3 cards -->
            <HBox spacing="20">

                <!-- Reservaciones -->
                <VBox prefWidth="280" prefHeight="160"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E8DDD5; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="📅" style="-fx-font-size: 24; -fx-text-fill: #C8552A;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Reservaciones"
                           style="-fx-font-size: 18; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
                    <Label text="Manage upcoming bookings"
                           style="-fx-font-size: 12; -fx-text-fill: #888888;"/>
                </VBox>

                <!-- Reportes Rápidos -->
                <VBox prefWidth="280" prefHeight="160"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E8DDD5; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📊" style="-fx-font-size: 24; -fx-text-fill: #C8552A;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="$1,240 Today"
                               style="-fx-font-size: 12; -fx-text-fill: #888888;"/>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Reportes Rápidos"
                           style="-fx-font-size: 18; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
                    <Label text="Sales overview"
                           style="-fx-font-size: 12; -fx-text-fill: #888888;"/>
                </VBox>

                <!-- Ajustes -->
                <VBox prefWidth="280" prefHeight="160"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E8DDD5; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <Label text="⚙️" style="-fx-font-size: 24; -fx-text-fill: #C8552A;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Ajustes"
                           style="-fx-font-size: 18; -fx-font-weight: BOLD; -fx-text-fill: #1A1A1A;"/>
                    <Label text="System configuration"
                           style="-fx-font-size: 12; -fx-text-fill: #888888;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>

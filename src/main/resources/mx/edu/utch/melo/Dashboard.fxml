<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="960" prefWidth="1280" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.edu.utch.melo.controller.DashboardController">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64" styleClass="topbar">
            <Region HBox.hgrow="ALWAYS" />
            <TextField prefWidth="260" promptText="Buscar..." styleClass="search-field">
                <HBox.margin>
                    <Insets left="16" />
                </HBox.margin>
            </TextField>
            <fx:include fx:id="topbar" source="Topbar.fxml" />
        </HBox>
    </top>

    <!-- ===== CONTENIDO CENTRAL ===== -->
    <center>
        <VBox styleClass="pad-dashboard gap-32">

            <!-- Saludo -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="txtSaludo" styleClass="text-header" text="Buenos días" />
                <Label fx:id="txtUsuario" styleClass="text-header" text="Usuario" />
            </HBox>

            <!-- Fila superior: Comedor (grande) + Domicilio -->
            <HBox spacing="20" HBox.hgrow="ALWAYS">

                <!-- Tarjeta Comedor -->
                <VBox prefHeight="280" prefWidth="600" styleClass="card-lg">
                    <Label styleClass="text-icon-lg-accent" text="🪑">
                        <VBox.margin>
                            <Insets bottom="16" />
                        </VBox.margin>
                    </Label>
                    <Label styleClass="text-title" text="Comedor" />
                    <Label maxWidth="320" styleClass="text-muted" text="Realiza pedidos al instante" wrapText="true" />
                    <Region VBox.vgrow="ALWAYS" />
                    <Button fx:id="btnComedor" styleClass="btn-primary" text="Realizar pedido" />
                </VBox>

                <!-- Tarjeta Domicilio -->
                <VBox prefHeight="280" prefWidth="280" styleClass="card">
                    <HBox alignment="TOP_RIGHT">
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="txtPedidosActivos" styleClass="badge badge-accent" text="3 activos" />
                    </HBox>
                    <Label styleClass="text-icon-lg-accent" text="🛵" />
                    <Region prefHeight="16.0" VBox.vgrow="ALWAYS" />
                    <Label styleClass="text-title-sm" text="Domicilio" />
                    <Label styleClass="text-muted" text="Para recoger o domicilios" />
                    <Button fx:id="btnDomicilio" styleClass="btn-primary" text="Realizar pedido">
                        <VBox.margin>
                            <Insets top="12" />
                        </VBox.margin>
                    </Button>
                </VBox>
            </HBox>

            <!-- Fila inferior: 3 tarjetas -->
            <HBox spacing="20">

                <!-- Reservaciones -->
                <VBox prefHeight="160" prefWidth="280" styleClass="card" HBox.hgrow="ALWAYS">
                    <Region VBox.vgrow="ALWAYS" />
                    <Label styleClass="text-title-sm" text="Reservaciones" />
                    <Label styleClass="text-muted" text="Maneja las reservaciones" />
                    <Button fx:id="btnReservaciones" alignment="CENTER" styleClass="btn-primary" text="Realizar pedido">
                        <VBox.margin>
                            <Insets top="12" />
                        </VBox.margin>
                    </Button>
                </VBox>

                <!-- Reportes Rápidos -->
                <VBox prefHeight="160" prefWidth="280" styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="text-icon-accent" text="📊" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="txtVentaActual" styleClass="text-muted" text="\$1,240 hoy" />
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Label styleClass="text-title-sm" text="Reportes Rápidos" />
                    <Label styleClass="text-muted" text="Ventas hasta el momento" />
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>

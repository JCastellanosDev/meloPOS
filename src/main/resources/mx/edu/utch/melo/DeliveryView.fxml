<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utch.melo.controller.DeliveryController"
            prefWidth="1280" prefHeight="960"
            stylesheets="@styles.css">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <HBox prefHeight="64" alignment="CENTER_LEFT" styleClass="topbar">
            <Label text="Terminal 01" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField prefWidth="220" promptText="Buscar..." styleClass="search-field"/>
            <Button text="🔄" styleClass="icon-button"/>
            <fx:include fx:id="topbar" source="Topbar.fxml"/>
        </HBox>
    </top>

    <!-- ===== CENTRO: Mapa ===== -->
    <center>
        <StackPane styleClass="pad-16">
            <!-- Mapa (usar WebView con mapa real en producción) -->
            <Pane styleClass="map-surface"/>

            <!-- Etiqueta de zona sobre el mapa -->
            <VBox alignment="CENTER" styleClass="map-pin-overlay">
                <StackPane>
                    <VBox alignment="CENTER" spacing="0" styleClass="map-pin-card">
                        <Label text="Zona Norte" styleClass="text-body-strong"/>
                        <Label text="400 pedidos" styleClass="text-price"/>
                    </VBox>
                </StackPane>
            </VBox>

            <!-- Sugerencia de IA (banner inferior) -->
            <VBox alignment="BOTTOM_CENTER" styleClass="pad-24">
                <VBox styleClass="ai-banner" maxWidth="560">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="🤖" styleClass="text-icon-accent"/>
                        <Label text="Sugerencia de Ruta (IA)" styleClass="text-body-strong"/>
                    </HBox>
                    <Label text="Se detectó alta demanda en Zona Norte. Se recomienda asignar 2 repartidores adicionales para mantener tiempos de entrega menores a 15 min."
                           styleClass="text-muted" wrapText="true" maxWidth="520"/>
                    <Button text="Asignar Repartidores" styleClass="btn-accent">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                    </Button>
                </VBox>
            </VBox>
        </StackPane>
    </center>

    <!-- ===== PANEL DERECHO ===== -->
    <right>
        <VBox prefWidth="340" prefHeight="960" styleClass="panel-right">

            <!-- Encabezado de analítica -->
            <Label text="Análisis de Domicilios" styleClass="text-title-sm"/>

            <!-- Fila de métricas -->
            <HBox spacing="0">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="84%" styleClass="stat-value-lg"/>
                    <Label text="Entregas a Tiempo" styleClass="text-muted"/>
                </VBox>
                <VBox alignment="TOP_RIGHT" spacing="4">
                    <Label text="24" styleClass="stat-value-accent"/>
                    <Label text="Repartidores Activos" styleClass="text-muted"/>
                </VBox>
            </HBox>

            <Separator/>

            <!-- Nuevo pedido -->
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Nuevo Pedido" styleClass="text-body-strong" HBox.hgrow="ALWAYS"/>
                    <Label text="Sin Asignar" styleClass="text-muted-sm"/>
                </HBox>

                <!-- Tarjeta de destino -->
                <VBox styleClass="dest-card">
                    <Label text="Destino" styleClass="text-muted-sm"/>
                    <Label text="Av. Tecnológico 1234" styleClass="text-body-strong"/>
                    <Label text="Cliente: María Rodríguez (VIP)" styleClass="text-muted"/>
                </VBox>

                <!-- Distancia / Tiempo / Precio -->
                <HBox spacing="8">
                    <VBox styleClass="mini-stat-box" HBox.hgrow="ALWAYS">
                        <Label text="📍" styleClass="text-body"/>
                        <Label text="4.2km" styleClass="text-body-strong"/>
                        <Label text="Distancia" styleClass="text-muted-sm"/>
                    </VBox>
                    <VBox styleClass="mini-stat-box" HBox.hgrow="ALWAYS">
                        <Label text="⏱" styleClass="text-body"/>
                        <Label text="11 min" styleClass="text-body-strong"/>
                        <Label text="Tiempo" styleClass="text-muted-sm"/>
                    </VBox>
                    <VBox styleClass="mini-stat-box-accent" HBox.hgrow="ALWAYS">
                        <Label text="💵" styleClass="text-body"/>
                        <Label text="\$35" styleClass="text-price"/>
                        <Label text="Sugerido" styleClass="text-price"/>
                    </VBox>
                </HBox>

                <Button text="Asignar Repartidor" maxWidth="Infinity" styleClass="btn-primary"/>
            </VBox>

            <Separator/>

            <!-- Pedidos activos -->
            <VBox spacing="12">
                <Label text="Pedidos Activos" styleClass="text-body-strong"/>

                <!-- Pedido 8892 -->
                <VBox styleClass="order-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Pedido #8892" styleClass="text-body-strong" HBox.hgrow="ALWAYS"/>
                        <Label text="● En Camino" styleClass="badge badge-success"/>
                    </HBox>
                    <Label text="Repartidor: Carlos M." styleClass="text-muted"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="📍" styleClass="text-muted"/>
                        <Label text="Blvd. Independencia 445" styleClass="text-muted"/>
                    </HBox>
                </VBox>

                <!-- Pedido 8891 -->
                <VBox styleClass="order-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Pedido #8891" styleClass="text-body-strong" HBox.hgrow="ALWAYS"/>
                        <Label text="● Recolección" styleClass="badge badge-accent"/>
                    </HBox>
                    <Label text="Repartidora: Ana G." styleClass="text-muted"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="📍" styleClass="text-muted"/>
                        <Label text="Calle 12, Zona Centro" styleClass="text-muted"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>

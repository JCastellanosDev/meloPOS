<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="raiz" prefHeight="960" prefWidth="1280" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.edu.utch.melo.controller.DeliveryController">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64" styleClass="topbar">
            <Label styleClass="topbar-title" text="Terminal 01" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscarPedido" prefWidth="220" promptText="Buscar por # de pedido..." styleClass="search-field" />
            <Button styleClass="icon-button">
                <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="18" /></graphic>
            </Button>
            <fx:include fx:id="topbar" source="Topbar.fxml" />
        </HBox>
    </top>

    <!-- ===== CENTRO: pedidos a domicilio activos ===== -->
    <center>
        <StackPane styleClass="pad-24">
            <children>
                <!-- Ocupa todo el ancho/alto disponible (ver CLAUDE.md: el mockup de mapa
                     que compartía este espacio ya se retiró aparte). -->
                <VBox styleClass="delivery-panel" spacing="20" maxWidth="Infinity" maxHeight="Infinity">

                    <VBox spacing="4">
                        <Label styleClass="text-title-sm" text="Pedidos a Domicilio" />
                        <Label styleClass="text-muted" text="Órdenes activas de la sucursal, con su estado actual." />
                    </VBox>

                    <!-- Estadísticas con datos reales (ver DeliveryController.actualizarEstadisticas):
                         no hay entidad "repartidor" en el esquema todavía, así que aquí no se
                         muestran tiempos de entrega ni asignación de repartidores (ver CLAUDE.md). -->
                    <HBox spacing="16">
                        <VBox styleClass="mini-stat-box-accent" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblTotalPedidos" styleClass="stat-value-accent" text="0" />
                            <Label styleClass="text-muted-sm" text="Pedidos activos" />
                        </VBox>
                        <VBox styleClass="mini-stat-box" alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblSumaTotales" styleClass="stat-value-lg" text="\$0.00" />
                            <Label styleClass="text-muted-sm" text="Valor en curso" />
                        </VBox>
                    </HBox>

                    <Separator />

                    <Label styleClass="text-body-strong" text="Pedidos Activos" />

                    <!-- Tarjetas generadas en tiempo de ejecución (ver DeliveryController) -->
                    <ScrollPane fitToWidth="true" styleClass="delivery-scroll" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="contenedorPedidos" hgap="16" vgap="16" />
                    </ScrollPane>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>

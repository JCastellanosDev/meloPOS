<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utch.melo.controller.KitchenDisplayController"
            prefWidth="1280" prefHeight="800"
            stylesheets="@styles.css">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <VBox styleClass="topbar">
            <HBox prefHeight="64" alignment="CENTER_LEFT" spacing="12">
                <Label text="Pantalla de Cocina - Terminal 1" styleClass="topbar-title"/>
                <!-- Insignia: se actualiza en tiempo de ejecución (ver KitchenDisplayController) -->
                <Label fx:id="lblActivas" text="0 Activas" styleClass="badge badge-muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblClock" text="23:34:43" styleClass="text-muted"/>
                <Button text="🔄" styleClass="icon-button"/>
                <Button text="🔔" styleClass="icon-button"/>
                <Button text="⚙️" styleClass="icon-button"/>
            </HBox>

            <!-- Pestañas de estación -->
            <HBox styleClass="pad-16 gap-8" alignment="CENTER_LEFT">
                <Button text="Todas las Estaciones" styleClass="station-tab-active"/>
                <Button text="Parrilla" styleClass="station-tab"/>
                <Button text="Preparación" styleClass="station-tab"/>
                <Button text="Freidora" styleClass="station-tab"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===== CENTRO: Tarjetas de órdenes (superficie oscura KDS) ===== -->
    <center>
        <StackPane styleClass="kds-surface">
            <ScrollPane fitToHeight="true" styleClass="kds-scroll">
                <!--
                  Contenedor dinámico: el controlador (KitchenDisplayController) llena este
                  HBox con los tickets de las órdenes en preparación leídas desde la base de
                  datos (ver TicketFactory). No debe contener tickets escritos de forma estática aquí.
                -->
                <HBox fx:id="contenedorTickets" styleClass="pad-16-20 gap-16" alignment="TOP_LEFT"/>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>

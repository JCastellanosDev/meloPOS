<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Pantalla de Cocina (KDS): ventana independiente, no una pestaña de la app
  (se abre vía Navigator.abrirVentana desde el Sidebar, ver SidebarController).
  Por eso no incluye Sidebar.fxml ni Topbar.fxml: es una terminal aparte,
  pensada para un monitor dedicado en cocina.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utch.melo.controller.KitchenDisplayController"
            prefWidth="1280" prefHeight="800"
            stylesheets="@styles.css">

    <!-- ===== FRANJA DE ESTADO ===== -->
    <top>
        <HBox prefHeight="56" alignment="CENTER_LEFT" spacing="12" styleClass="kds-status-bar">
            <FontIcon iconLiteral="mdi2c-chef-hat" iconSize="22" styleClass="kds-status-icon"/>
            <Label text="Pantalla de Cocina" styleClass="kds-status-title"/>
            <!-- Insignia: se actualiza en tiempo de ejecución (ver KitchenDisplayController) -->
            <Label fx:id="lblActivas" text="0 Activas" styleClass="badge badge-muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblClock" text="--:--:--" styleClass="kds-status-clock"/>
        </HBox>
    </top>

    <!-- ===== CENTRO: Tarjetas de órdenes (superficie oscura KDS) ===== -->
    <center>
        <StackPane styleClass="kds-surface">
            <ScrollPane fitToHeight="true" styleClass="kds-scroll">
                <!--
                  Contenedor dinámico: el controlador (KitchenDisplayController) llena este
                  HBox con los tickets de las órdenes en preparación leídas desde la base de
                  datos (ver TicketFactory). No debe contener tickets escritos de forma estática aquí.
                -->
                <HBox fx:id="contenedorTickets" styleClass="pad-16-20 gap-16" alignment="TOP_LEFT"/>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>

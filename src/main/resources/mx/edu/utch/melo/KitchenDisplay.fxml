<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Pantalla de Cocina (KDS): ventana independiente, no una pestaña de la app
  (se abre vía Navigator.abrirVentana desde el Sidebar, ver SidebarController).
  Por eso no incluye Sidebar.fxml ni Topbar.fxml: es una terminal aparte,
  pensada para un monitor dedicado en cocina.
-->

<BorderPane prefHeight="800" prefWidth="1280" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.edu.utch.melo.controller.KitchenDisplayController">

    <!-- ===== FRANJA DE ESTADO ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56" spacing="12" styleClass="kds-status-bar">
            <FontIcon iconLiteral="mdi2c-chef-hat" iconSize="22" styleClass="kds-status-icon" />
            <Label styleClass="kds-status-title" text="Pantalla de Cocina" />
            <!-- Insignia: se actualiza en tiempo de ejecución (ver KitchenDisplayController) -->
            <Label fx:id="lblActivas" styleClass="badge badge-muted" text="0 Activas" />
            <Region HBox.hgrow="ALWAYS" />

            <!-- Densidad de la cuadrícula: cuántos tickets caben a la vista (ver KitchenDisplayController.aplicarColumnas).
                 El número solo (ver auditoría UI/UX) no es autoexplicativo para un cocinero nuevo: el
                 ícono de grid da contexto, el tooltip lo hace explícito sin agregar texto permanente. -->
            <HBox alignment="CENTER" spacing="6" styleClass="kds-toolbar-group">
                <FontIcon iconLiteral="mdi2v-view-grid" iconSize="16" styleClass="kds-status-icon" />
                <Button fx:id="btnDensidad3" onAction="#onDensidad3" styleClass="kds-toolbar-btn" text="6">
                    <tooltip><Tooltip text="6 comandas visibles a la vez" /></tooltip>
                </Button>
                <Button fx:id="btnDensidad4" onAction="#onDensidad4" styleClass="kds-toolbar-btn" text="8">
                    <tooltip><Tooltip text="8 comandas visibles a la vez" /></tooltip>
                </Button>
                <Button fx:id="btnDensidad6" onAction="#onDensidad6" styleClass="kds-toolbar-btn" text="12">
                    <tooltip><Tooltip text="12 comandas visibles a la vez" /></tooltip>
                </Button>
            </HBox>

            <!-- Tamaño de texto global de los tickets (ver KitchenDisplayController.cambiarNivelTamano) -->
            <HBox alignment="CENTER" spacing="6" styleClass="kds-toolbar-group">
                <Button onAction="#onDisminuirTexto" styleClass="kds-toolbar-btn">
                    <graphic>
                        <FontIcon iconLiteral="mdi2f-format-font-size-decrease" iconSize="16" />
                    </graphic>
                    <tooltip><Tooltip text="Reducir tamaño de texto" /></tooltip>
                </Button>
                <Label fx:id="lblNivelTexto" styleClass="kds-toolbar-label" text="Normal" />
                <Button onAction="#onAumentarTexto" styleClass="kds-toolbar-btn">
                    <graphic>
                        <FontIcon iconLiteral="mdi2f-format-font-size-increase" iconSize="16" />
                    </graphic>
                    <tooltip><Tooltip text="Aumentar tamaño de texto" /></tooltip>
                </Button>
            </HBox>

            <!-- Antes tenía un margen derecho de 500px heredado de un ajuste manual anterior a
                 que existieran los grupos de densidad/tamaño de texto: con el Region de arriba
                 ya empujando este bloque al borde derecho, ese margen extra sacaba el reloj en
                 vivo fuera del área visible de la franja de estado (ver auditoría UI/UX). -->
            <Label fx:id="lblClock" styleClass="kds-status-clock" text="00:00">
            <font>
               <Font size="18.0" />
            </font></Label>
        </HBox>
    </top>

    <!-- ===== CENTRO: Tarjetas de órdenes (superficie oscura KDS) ===== -->
    <center>
        <StackPane styleClass="kds-surface">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="kds-scroll">
                <!--
                  Cuadrícula de 2 filas x N columnas (N configurable en tiempo de ejecución vía
                  los botones de densidad de la franja de estado, ver
                  KitchenDisplayController.aplicarColumnas), forzada a ocupar todo el ScrollPane
                  (fitToWidth + fitToHeight, columnConstraints + rowConstraints al 100% entre las
                  N/2). Las 4 columnas de aquí abajo son solo el valor inicial: el controlador
                  reemplaza columnConstraints por completo al cambiar de densidad, ya que FXML es
                  estático. El controlador llena la cuadrícula con los tickets de las órdenes en
                  preparación leídas desde la base de datos (ver TicketFactory), y cada tarjeta se
                  estira para llenar su celda (ver GridPane.setHgrow/setVgrow en
                  renderizarTickets). No debe contener tickets escritos de forma estática aquí.

                  Límite conocido: al forzar fitToHeight, si hay más órdenes activas que celdas
                  visibles, la fila de más (sin rowConstraints propias) se aprieta en vez de
                  habilitar scroll vertical: no se resolvió aquí porque no se pidió explícitamente.
                -->
                <GridPane fx:id="contenedorTickets" hgap="0" vgap="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="50" />
                        <RowConstraints percentHeight="50" />
                    </rowConstraints>
                </GridPane>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>

                        style="-fx-background-color: transparent; -fx-text-fill: #9A7060; -fx-font-size: 13; -fx-padding: 10 14; -fx-cursor: HAND;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 0 10 20 10; -fx-spacing: 2;">
                <Button text="📊  Reportes" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #9A7060; -fx-font-size: 13; -fx-padding: 10 14; -fx-cursor: HAND;"/>
                <Button text="⚙️  Configuración" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #9A7060; -fx-font-size: 13; -fx-padding: 10 14; -fx-cursor: HAND;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox prefHeight="60" alignment="CENTER"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E8DDD5; -fx-border-width: 0 0 1 0; -fx-padding: 0 20; -fx-spacing: 16;">

            </VBox>

            <!-- Nav -->
            <VBox style="-fx-padding: 16 10 0 10; -fx-spacing: 2;">
                <!-- Active item -->
                <Button text="🍽  Platillos" maxWidth="Infinity" alignment="CENTER_LEFT"
                        style="-fx-background-color: #C8552A; -fx-text-fill: #FFFFFF; -fx-font-size: 13; -fx-font-weight: BOLD; -fx-background-radius: 8; -fx-padding: 10 14; -fx-cursor: HAND;"/>

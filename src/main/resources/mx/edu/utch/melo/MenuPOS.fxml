<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utch.melo.controller.MenuPOSController"
            prefWidth="1280" prefHeight="960"
            stylesheets="@styles.css">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <VBox styleClass="topbar">
            <HBox prefHeight="64" alignment="CENTER_LEFT" spacing="16">
                <TextField promptText="Buscar platillo..." prefWidth="260" styleClass="search-field"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🪑  Mesa 12  ▾" styleClass="pill-button"/>
                <fx:include fx:id="topbar" source="Topbar.fxml"/>
            </HBox>

            <!-- Categorías del menú -->
            <HBox styleClass="pad-16 gap-8" alignment="CENTER_LEFT">
                <Button fx:id="btnCategoriaPlatillos" text="🍽  Platillos" styleClass="tab-item-active"/>
                <Button fx:id="btnCategoriaBebidas" text="🍹  Bebidas" styleClass="tab-item"/>
                <Button fx:id="btnCategoriaPostres" text="🍮  Postres" styleClass="tab-item"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===== CENTRO: Rejilla de platillos ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="kds-scroll">
            <!--
              Contenedor dinámico: el controlador (MenuPOSController) llena este
              FlowPane con las tarjetas de los platillos leídas desde la base de
              datos. No debe contener platillos escritos de forma estática aquí.
            -->
            <FlowPane fx:id="contenedorMenu" hgap="16" vgap="16" styleClass="pad-24"/>
        </ScrollPane>
    </center>

    <!-- ===== DERECHA: Panel de la orden ===== -->
    <right>
        <VBox prefWidth="320" prefHeight="960" styleClass="order-panel pad-24 gap-0">

            <!-- Encabezado -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Orden #425" styleClass="text-title-sm"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Mesa 12" styleClass="text-muted"/>
            </HBox>
            <Label text="Mesero: Ana Martínez" styleClass="text-muted">
                <VBox.margin><Insets top="2" bottom="16"/></VBox.margin>
            </Label>

            <Separator>
                <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Separator>

            <!-- Artículos de la orden: se generan en tiempo de ejecución (ver MenuPOSController) -->
            <VBox fx:id="listaArticulos" styleClass="gap-12 pad-y-16"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Totales + botón de pago -->
            <VBox styleClass="totals-box">
                <HBox>
                    <Label text="Subtotal" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSubtotal" text="\$0.00" styleClass="text-body"/>
                </HBox>
                <HBox>
                    <Label text="IVA (16%)" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblIva" text="\$0.00" styleClass="text-body"/>
                </HBox>
                <Separator/>
                <HBox>
                    <Label text="Total" styleClass="text-price-lg" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="\$0.00" styleClass="text-price-lg"/>
                </HBox>
                <Label fx:id="lblErrorCobro" styleClass="form-error" wrapText="true" visible="false" managed="false"/>
                <Button fx:id="btnCobrar" text="💳  Cobrar Cuenta" maxWidth="Infinity" styleClass="btn-accent-block" onAction="#onCobrarCuenta">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Button>
            </VBox>
        </VBox>
    </right>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Ventana emergente de cobro: se abre desde MenuPOSController.onCobrarCuenta
  (ver Navigator.abrirVentana), no es una pestaña del sidebar. Muestra el
  desglose de artículos (ver contenedorTicket) además del total a pagar,
  descuento, método de pago y teclado numérico (ver PaymentPortalController).
-->

<BorderPane fx:id="raiz" prefHeight="700.0" prefWidth="350.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.edu.utch.melo.controller.PaymentPortalController">

    <!-- ===== BARRA SUPERIOR =====
         Restaurada: faltaba por completo en este archivo, así que fx:id="lblNumeroOrden" nunca se
         inyectaba y PaymentPortalController.mostrarSinOrden() lanzaba NullPointerException al abrir
         esta ventana en cualquier caso sin orden en curso (detectado al correr FxmlSmokeTest). -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="56" spacing="12" styleClass="topbar">
            <FontIcon iconLiteral="mdi2c-cash" iconSize="20" styleClass="text-icon-accent" />
            <Label styleClass="text-title-sm" text="Cobrar" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblNumeroOrden" styleClass="text-muted" text="Orden #—" />
        </HBox>
    </top>

    <!-- ===== CENTRO ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="kds-scroll">
            <VBox styleClass="pad-24 gap-20">

                <!-- ===== TICKET ===== -->
                <VBox styleClass="card gap-8">
                    <Label styleClass="text-label-caps" text="TICKET" />
                    <VBox fx:id="contenedorTicket" spacing="8" />
                </VBox>

                <!-- ===== TOTAL A PAGAR ===== -->
                <VBox styleClass="card gap-8">
                    <HBox fx:id="filaTotalOriginal" managed="false" visible="false">
                        <Label styleClass="text-muted" text="Total" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalOriginal" styleClass="text-body" text="\$0.00" />
                    </HBox>
                    <HBox fx:id="filaDescuentoInfo" managed="false" visible="false">
                        <Label fx:id="lblDescuentoEtiqueta" styleClass="text-muted" text="Descuento" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblDescuentoMonto" styleClass="text-price" text="-\$0.00" />
                    </HBox>
                    <HBox>
                        <Label styleClass="text-label-caps" text="Total a pagar" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalAPagar" styleClass="text-price-lg" text="\$0.00" />
                    </HBox>
                </VBox>

                <!-- ===== DESCUENTO ===== -->
                <!-- Las categorías viven en su propia ventana emergente (ver Pantalla.SELECCIONAR_DESCUENTO)
                     para no ocupar espacio aquí: este panel solo muestra un botón para abrirla,
                     el resultado ya aplicado, o la autorización de Administrador en curso. -->
                <VBox styleClass="card gap-12">
                    <Label styleClass="text-label-caps" text="DESCUENTO" />

                    <Button fx:id="btnElegirDescuento" graphicTextGap="8" maxWidth="Infinity" onAction="#onAbrirSeleccionDescuento" styleClass="btn-outline-accent" text="Elegir descuento">
                        <graphic><FontIcon iconLiteral="mdi2s-sale" iconSize="16" /></graphic>
                    </Button>

                    <!-- Ya hay un descuento aplicado: se puede quitar, sin pedir autorización de nuevo. -->
                    <HBox fx:id="filaDescuentoAplicado" alignment="CENTER_LEFT" managed="false" spacing="10" visible="false">
                        <Label fx:id="lblDescuentoAplicadoTexto" styleClass="text-body-strong" text="—" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnQuitarDescuento" onAction="#onQuitarDescuento" styleClass="btn-outline" text="Quitar" />
                    </HBox>

                    <!-- Autorización de Administrador: aparece al regresar de SeleccionarDescuento con una categoría elegida. -->
                    <VBox fx:id="panelAutorizacion" managed="false" styleClass="change-box" visible="false">
                        <Label fx:id="lblAutorizacionTitulo" styleClass="text-body-strong" text="—" wrapText="true" />
                        <Label styleClass="text-muted" text="PIN de Administrador" />
                        <PasswordField fx:id="txtPinAutorizacion" onAction="#onAutorizarDescuento" promptText="••••" styleClass="search-field" />
                        <Label fx:id="lblErrorDescuento" managed="false" styleClass="form-error" visible="false" wrapText="true" />
                        <HBox spacing="10">
                            <Button maxWidth="Infinity" onAction="#onCancelarAutorizacion" styleClass="btn-outline" text="Cancelar" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAutorizarDescuento" maxWidth="Infinity" onAction="#onAutorizarDescuento" styleClass="btn-accent" text="Autorizar" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ===== MODO DE PAGO ===== -->
                <HBox spacing="0">
                    <Button fx:id="tabPagoUnico" maxWidth="Infinity" onAction="#onModoPagoUnico" styleClass="tab-item-active" text="Pago único" HBox.hgrow="ALWAYS" />
                    <Button fx:id="tabPagoDividido" maxWidth="Infinity" onAction="#onModoPagoDividido" styleClass="tab-item" text="Pago dividido" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- ===== PAGO ÚNICO ===== -->
                <VBox fx:id="panelPagoUnico" spacing="16">
                    <!-- alignment="CENTER" declarado también aquí, no solo en .pay-method/.pay-method-active
                         (ver pedido explícito del dueño): el ícono + etiqueta de cada tile deben quedar
                         a la mitad, tanto horizontal como verticalmente, dentro del VBox de 90px de alto. -->
                    <HBox alignment="CENTER" spacing="12">
                        <VBox fx:id="tileEfectivo" alignment="CENTER" onMouseClicked="#onEfectivoClick" prefHeight="90" styleClass="pay-method-active gap-6" HBox.hgrow="ALWAYS">
                            <FontIcon iconLiteral="mdi2c-cash" iconSize="24" styleClass="text-icon-lg-accent" />
                            <Label fx:id="lblEfectivo" styleClass="pay-method-label-active" text="Efectivo" />
                        </VBox>
                        <VBox fx:id="tileTarjeta" alignment="CENTER" onMouseClicked="#onTarjetaClick" prefHeight="90" styleClass="pay-method gap-6" HBox.hgrow="ALWAYS">
                            <FontIcon iconLiteral="mdi2c-credit-card-outline" iconSize="24" styleClass="text-icon-lg-accent" />
                            <Label fx:id="lblTarjeta" styleClass="pay-method-label" text="Tarjeta" />
                        </VBox>
                        <VBox fx:id="tileTransferencia" alignment="CENTER" onMouseClicked="#onTransferenciaClick" prefHeight="90" styleClass="pay-method gap-6" HBox.hgrow="ALWAYS">
                            <FontIcon iconLiteral="mdi2b-bank-transfer" iconSize="24" styleClass="text-icon-lg-accent" />
                            <Label fx:id="lblTransferencia" alignment="CENTER" contentDisplay="CENTER" styleClass="pay-method-label" text="Transferencia" textAlignment="CENTER" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox styleClass="card gap-16">
                        <Label styleClass="text-label-caps" text="RECIBIDO" />
                        <HBox styleClass="amount-box">
                            <Label styleClass="amount-currency" text="\$" />
                            <Label fx:id="lblRecibido" styleClass="amount-value" text="0.00" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <VBox styleClass="change-box">
                            <Label styleClass="text-label-caps" text="CAMBIO" />
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="lblCambio" styleClass="change-value" text="\$0.00" HBox.hgrow="ALWAYS" />
                                <Button onAction="#onReiniciarRecibido" styleClass="icon-button">
                                    <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16" /></graphic>
                                    <tooltip><Tooltip text="Reiniciar monto recibido" /></tooltip>
                                </Button>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ===== PAGO DIVIDIDO ===== -->
                <VBox fx:id="panelPagoDividido" managed="false" spacing="16" visible="false">
                    <VBox fx:id="cajaEfectivoDividido" onMouseClicked="#onSeleccionarCampoEfectivo" styleClass="amount-box-active">
                        <Label styleClass="text-label-caps" text="EFECTIVO" />
                        <HBox>
                            <Label styleClass="amount-currency" text="\$" />
                            <Label fx:id="lblEfectivoDividido" styleClass="amount-value" text="0.00" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox fx:id="cajaTarjetaDividido" onMouseClicked="#onSeleccionarCampoTarjeta" styleClass="amount-box">
                        <Label styleClass="text-label-caps" text="TARJETA" />
                        <HBox>
                            <Label styleClass="amount-currency" text="\$" />
                            <Label fx:id="lblTarjetaDividido" styleClass="amount-value" text="0.00" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblFaltanteDividido" styleClass="text-muted" text="Falta \$0.00" HBox.hgrow="ALWAYS" />
                        <Button onAction="#onLimpiarPagoDividido" styleClass="btn-outline" text="Limpiar" />
                    </HBox>
                </VBox>

                <!-- ===== TECLADO NUMÉRICO (compartido) ===== -->
                <!-- halignment/valignment CENTER en cada columna/fila (ver pedido explícito del dueño):
                     antes las columnas se repartían el ancho completo por porcentaje, pero cada botón
                     (56x56 fijo, ver .numpad-btn) quedaba pegado a la esquina superior izquierda de su
                     celda en vez de centrado dentro de ella: comportamiento por defecto de GridPane
                     cuando una celda es más grande que su contenido y no se declara alineación. -->
                <GridPane alignment="CENTER" hgap="10" vgap="10">
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="3" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="7" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="8" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="9" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="." GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Button onAction="#onTeclaNumpad" styleClass="numpad-btn-danger" text="⌫" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" percentWidth="33.3" />
                        <ColumnConstraints halignment="CENTER" percentWidth="33.3" />
                        <ColumnConstraints halignment="CENTER" percentWidth="33.3" />
                    </columnConstraints>
               <rowConstraints>
                  <RowConstraints valignment="CENTER" />
                  <RowConstraints valignment="CENTER" />
                  <RowConstraints valignment="CENTER" />
                  <RowConstraints valignment="CENTER" />
               </rowConstraints>
                </GridPane>

                <Label fx:id="lblErrorPago" managed="false" styleClass="form-error" visible="false" wrapText="true" />

                <Button fx:id="btnConfirmarPago" graphicTextGap="8" maxWidth="Infinity" onAction="#onConfirmarPago" prefHeight="56" styleClass="btn-accent-block" text="Confirmar Pago">
                    <graphic><FontIcon iconLiteral="mdi2c-check-circle-outline" iconSize="18" /></graphic>
                </Button>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

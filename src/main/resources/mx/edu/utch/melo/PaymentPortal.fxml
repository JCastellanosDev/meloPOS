<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utch.melo.controller.PaymentPortalController"
            prefWidth="1280" prefHeight="960"
            stylesheets="@styles.css">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <VBox>
            <fx:include fx:id="sidebar" source="Sidebar.fxml">
                <VBox.vgrow>ALWAYS</VBox.vgrow>
            </fx:include>
            <!-- Cerrar turno -->
            <VBox styleClass="sidebar-extra-section">
                <Button text="Cerrar Turno" maxWidth="Infinity" styleClass="btn-accent-block"/>
            </VBox>
        </VBox>
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <HBox prefHeight="64" alignment="CENTER_LEFT" styleClass="topbar">
            <Label text="Portal de Pagos" styleClass="text-title-sm"/>
            <!-- Pestañas -->
            <HBox spacing="4" styleClass="pad-0-24">
                <Button text="Comedor" styleClass="tab-item"/>
                <Button text="Para Llevar" styleClass="tab-item-active"/>
                <Button text="Domicilio" styleClass="tab-item"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField promptText="Buscar orden..." prefWidth="240" styleClass="search-field"/>
            <Button text="🔔" styleClass="icon-button"/>
            <Button text="Nueva Orden" styleClass="btn-primary"/>
        </HBox>
    </top>

    <!-- ===== CENTRO ===== -->
    <center>
        <HBox styleClass="pad-24 gap-20" alignment="TOP_CENTER">

            <!-- IZQUIERDA: Recibo / Resumen de la orden -->
            <VBox prefWidth="340" minHeight="700" styleClass="card-lg gap-0">
                <!-- Encabezado -->
                <VBox alignment="CENTER" styleClass="gap-4 pad-bottom-16">
                    <Label text="L'Étoile Noir" styleClass="text-body-strong"/>
                    <Label text="ORDEN #15925" styleClass="text-muted"/>
                    <Label text="24 Oct 2023, 19:42" styleClass="text-muted"/>
                    <Label text="Usuario: [Nombre de usuario]" styleClass="text-muted"/>
                    <Label text="Cajero: Vakero" styleClass="text-muted"/>
                </VBox>

                <Separator styleClass="pad-bottom-16"/>

                <!-- Artículos -->
                <VBox styleClass="gap-12 pad-y-16">
                    <HBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="1x  Hamburguesa con Tocino y Queso" styleClass="text-body"/>
                            <Label text="Extra queso, término medio" styleClass="text-muted-sm"/>
                        </VBox>
                        <Label text="\$104.00" styleClass="text-body"/>
                    </HBox>
                    <HBox>
                        <Label text="2x  Espresso Doble" styleClass="text-body" HBox.hgrow="ALWAYS"/>
                        <Label text="\$72.00" styleClass="text-body"/>
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Totales -->
                <VBox styleClass="totals-box">
                    <HBox>
                        <Label text="Subtotal" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
                        <Label text="\$176.00" styleClass="text-body"/>
                    </HBox>
                    <HBox>
                        <Label text="IVA (16%)" styleClass="text-muted" HBox.hgrow="ALWAYS"/>
                        <Label text="\$28.16" styleClass="text-body"/>
                    </HBox>
                    <HBox>
                        <Label text="Total" styleClass="text-price-lg" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalCuenta" text="\$204.16" styleClass="text-price-lg"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- CENTRO: Método de pago + monto recibido -->
            <VBox prefWidth="340" spacing="16">

                <!-- Métodos de pago -->
                <HBox spacing="12">
                    <!-- Efectivo (activo) -->
                    <VBox fx:id="tileEfectivo" prefWidth="100" prefHeight="110" styleClass="pay-method-active gap-8" onMouseClicked="#onEfectivoClick">
                        <Label text="💵" styleClass="text-icon-lg-accent"/>
                        <Label fx:id="lblEfectivo" text="Efectivo" styleClass="pay-method-label-active"/>
                    </VBox>
                    <!-- Tarjeta -->
                    <VBox fx:id="tileTarjeta" prefWidth="100" prefHeight="110" styleClass="pay-method gap-8" HBox.hgrow="ALWAYS" onMouseClicked="#onTarjetaClick">
                        <Label text="💳" styleClass="text-icon-lg-accent"/>
                        <Label fx:id="lblTarjeta" text="Tarjeta" styleClass="pay-method-label"/>
                    </VBox>
                    <!-- Transferencia -->
                    <VBox fx:id="tileTransferencia" prefWidth="100" prefHeight="110" styleClass="pay-method gap-8" HBox.hgrow="ALWAYS" onMouseClicked="#onTransferenciaClick">
                        <Label text="📱" styleClass="text-icon-lg-accent"/>
                        <Label fx:id="lblTransferencia" text="Transferencia" styleClass="pay-method-label" textAlignment="CENTER" wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Recibido + Cambio -->
                <VBox styleClass="card gap-16">

                    <Label text="RECIBIDO" styleClass="text-label-caps"/>

                    <!-- Monto -->
                    <HBox styleClass="amount-box">
                        <Label text="\$" styleClass="amount-currency"/>
                        <Label fx:id="lblRecibido" text="500.00" styleClass="amount-value" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Cambio -->
                    <VBox styleClass="change-box">
                        <Label text="CAMBIO" styleClass="text-label-caps"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblCambio" text="\$295.84" styleClass="change-value" HBox.hgrow="ALWAYS"/>
                            <Button text="🔄" styleClass="icon-button" onAction="#onReiniciarRecibido"/>
                        </HBox>
                    </VBox>

                    <!-- Botones de acción -->
                    <HBox spacing="12" styleClass="pad-top-8">
                        <Button text="🖨  No imprimir" prefWidth="140" prefHeight="56" styleClass="btn-outline-accent" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnConfirmarPago" text="✅  Confirmar Pago" prefWidth="140" prefHeight="56" styleClass="btn-accent" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- DERECHA: Teclado numérico -->
            <VBox prefWidth="200" spacing="0">
                <!-- Rejilla de números -->
                <GridPane hgap="10" vgap="10">
                    <!-- Fila 1: 1 2 3 -->
                    <Button text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="2" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="3" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <!-- Fila 2: 4 5 6 -->
                    <Button text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <!-- Fila 3: 7 8 9 -->
                    <Button text="7" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="8" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="9" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <!-- Fila 4: . 0 ⌫ -->
                    <Button text="." GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="numpad-btn" onAction="#onTeclaNumpad"/>
                    <Button text="⌫" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="numpad-btn-danger" onAction="#onTeclaNumpad"/>
                </GridPane>

                <!-- Montos rápidos -->
                <VBox spacing="10" styleClass="pad-top-24">
                    <HBox spacing="10">
                        <Button text="\$200" prefWidth="90" styleClass="quick-amount-btn" HBox.hgrow="ALWAYS" onAction="#onMontoRapido"/>
                        <Button text="\$500" prefWidth="90" styleClass="quick-amount-btn" HBox.hgrow="ALWAYS" onAction="#onMontoRapido"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="\$1000" prefWidth="90" styleClass="quick-amount-btn" HBox.hgrow="ALWAYS" onAction="#onMontoRapido"/>
                        <Button text="Exacto" prefWidth="90" styleClass="quick-amount-btn-primary" HBox.hgrow="ALWAYS" onAction="#onMontoRapido"/>
                    </HBox>
                </VBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.edu.utch.melo.controller.RegisterClientController"
            prefWidth="1280" prefHeight="960"
            stylesheets="@styles.css">

    <!-- ===== MENÚ LATERAL ===== -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
    </left>

    <!-- ===== BARRA SUPERIOR ===== -->
    <top>
        <HBox prefHeight="64" alignment="CENTER_LEFT" styleClass="topbar">
            <Label text="Clientes" styleClass="breadcrumb-text"/>
            <Label text="›" styleClass="breadcrumb-sep"/>
            <Label text="Registrar Cliente" styleClass="breadcrumb-active"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="＋  Nueva Mesa" styleClass="btn-accent"/>
            <Button text="🔍" styleClass="icon-button"/>
            <fx:include fx:id="topbar" source="Topbar.fxml"/>
        </HBox>
    </top>

    <!-- ===== CENTRO: Formulario de registro ===== -->
    <center>
        <HBox styleClass="pad-32 gap-24" alignment="TOP_LEFT">

            <!-- Panel del formulario -->
            <VBox prefWidth="580" styleClass="card-lg gap-0">
                <Label text="Registrar Nuevo Cliente" styleClass="text-subtitle"/>
                <Label text="Ingrese los datos del cliente para añadirlo al sistema." styleClass="text-muted" wrapText="true">
                    <VBox.margin><Insets top="4" bottom="24"/></VBox.margin>
                </Label>

                <!-- Nombre -->
                <Label text="NOMBRE Y APELLIDO" styleClass="text-label-caps"/>
                <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                    <VBox.margin><Insets top="6" bottom="20"/></VBox.margin>
                    <Label text="👤" styleClass="input-icon"/>
                    <TextField fx:id="txtNombre" promptText="Ej. Juan Pérez" prefWidth="480" styleClass="input-plain"/>
                </HBox>

                <!-- Teléfono -->
                <Label text="NÚMERO DE CELULAR" styleClass="text-label-caps"/>
                <HBox alignment="CENTER_LEFT" styleClass="input-wrapper">
                    <VBox.margin><Insets top="6" bottom="20"/></VBox.margin>
                    <Label text="📱" styleClass="input-icon"/>
                    <TextField fx:id="txtPhone" promptText="Ej. 300 123 4567" prefWidth="480" styleClass="input-plain"/>
                </HBox>

                <!-- Dirección -->
                <Label text="DIRECCIÓN DE ENTREGA" styleClass="text-label-caps"/>
                <HBox alignment="CENTER" spacing="8">
                    <VBox.margin><Insets top="6" bottom="6"/></VBox.margin>
                    <HBox alignment="CENTER_LEFT" styleClass="input-wrapper" HBox.hgrow="ALWAYS">
                        <Label text="📍" styleClass="input-icon"/>
                        <TextField fx:id="txtAddress" promptText="Calle, Carrera, Barrio, Detalles adicionales..." prefWidth="350" styleClass="input-plain"/>
                    </HBox>
                    <Button text="🗺  Ubicar" styleClass="btn-outline-accent"/>
                </HBox>
                <Label text="Use el mapa para mayor precisión en entregas a domicilio." styleClass="text-muted-lighter">
                    <VBox.margin><Insets bottom="16"/></VBox.margin>
                </Label>

                <!-- Mapa (placeholder) -->
                <Pane prefHeight="200" styleClass="map-placeholder">
                    <VBox.margin><Insets bottom="8"/></VBox.margin>
                    <StackPane prefWidth="580" prefHeight="200">
                        <VBox alignment="CENTER" spacing="6">
                            <Label text="📍" styleClass="text-icon-lg-accent"/>
                            <Button text="Abrir Google Maps" styleClass="btn-outline"/>
                        </VBox>
                    </StackPane>
                </Pane>

                <Separator styleClass="pad-8"/>

                <!-- Mensaje de validación -->
                <Label fx:id="lblError" styleClass="form-error" wrapText="true" visible="false" managed="false"/>

                <!-- Botones de acción -->
                <HBox spacing="12" styleClass="pad-top-16">
                    <Button text="Cancelar" prefWidth="140" styleClass="btn-outline" onAction="#onCancelar"/>
                    <Button text="💾  Guardar Cliente" HBox.hgrow="ALWAYS" styleClass="btn-primary" onAction="#onGuardarCliente"/>
                </HBox>
            </VBox>

            <!-- Panel derecho -->
            <VBox spacing="16" prefWidth="300">

                <!-- Búsqueda por filtro -->
                <VBox styleClass="card gap-12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="🔍" styleClass="text-body"/>
                        <Label text="Buscar por Filtro" styleClass="text-body-strong"/>
                    </HBox>
                    <Label text="Verifique si el cliente ya existe antes de crear uno nuevo." styleClass="text-muted" wrapText="true" maxWidth="260"/>

                    <TextField promptText="Teléfono, Nombre o ID..." styleClass="search-field"/>

                    <!-- Chips de filtro -->
                    <HBox spacing="8" styleClass="pad-top-4">
                        <Button text="Recientes" styleClass="chip"/>
                        <Button text="Barrio Centro" styleClass="chip"/>
                        <Button text="Empresas" styleClass="chip"/>
                    </HBox>

                    <!-- Estado vacío -->
                    <VBox styleClass="empty-state">
                        <Label text="🔍" styleClass="empty-state-icon"/>
                        <Label text="Los resultados aparecerán aquí" styleClass="empty-state-text" maxWidth="200" textAlignment="CENTER"/>
                    </VBox>
                </VBox>

                <!-- Consejo de servicio -->
                <VBox styleClass="tip-box">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="ℹ️" styleClass="text-body"/>
                        <Label text="Consejo de Servicio" styleClass="tip-title"/>
                    </HBox>
                    <Label text="Para entregas recurrentes, asegúrese de guardar referencias claras en la dirección. Un registro preciso reduce los tiempos de entrega."
                           styleClass="text-muted" wrapText="true" maxWidth="260"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Menú lateral (Sidebar) reutilizable.
  Cada pantalla lo incluye con <fx:include source="Sidebar.fxml" fx:id="sidebar"/>
  y, si lo necesita, marca su sección activa desde el controlador de la pantalla
  llamando a sidebarController.setActivo(sidebarController.getBtnX()).
-->
<VBox prefWidth="228" prefHeight="960" styleClass="sidebar"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.edu.utch.melo.controller.SidebarController">

    <!-- Logo: al hacer clic regresa al Dashboard (ver onLogoClick). Antes sin ninguna señal de que
         fuera interactivo (ver auditoría UI/UX): es la única forma de volver al Dashboard, no hay
         botón de navegación propio para eso. VBox no es un Control: no tiene propiedad "tooltip"
         propia en FXML, por eso el tooltip se instala por código (ver SidebarController,
         Tooltip.install) en vez de declararse aquí. -->
    <VBox fx:id="logoContenedor" styleClass="sidebar-logo" onMouseClicked="#onLogoClick">
        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@img/melo1.png" />
            </image>
        </ImageView>
    </VBox>

    <!-- Navegación principal -->
    <VBox styleClass="sidebar-nav">
        <Button fx:id="btnMenu" text="Menú" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2s-silverware-fork-knife" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnCocina" text="Cocina" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2c-chef-hat" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnDomicilio" text="Domicilio" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2m-moped" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnPedidos" text="Pedidos" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2c-clipboard-list" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnPersonal" text="Personal" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2a-account-tie" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnInventario" text="Inventario" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2b-box" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnReportes" text="Reportes" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2c-chart-line" iconSize="18" /></graphic>
        </Button>
        <Button fx:id="btnCaja" text="Caja" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2c-cash-register" iconSize="18" /></graphic>
        </Button>
        <!-- Movido al final de la navegación principal (ver auditoría UI/UX): sigue deshabilitado
             a propósito ("no es prioridad ahora", ver CLAUDE.md), pero antes ocupaba el primer
             lugar de la lista, por delante de "Menú": la función real más usada del sistema
             quedaba en segundo lugar visual detrás de una que no se puede usar todavía. -->
        <Button fx:id="btnMesas" text="Mesas" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2t-table-chair" iconSize="18" /></graphic>
        </Button>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <!-- Navegación inferior -->
    <VBox styleClass="sidebar-nav-bottom">
        <Button fx:id="btnAjustes" text="Ajustes" graphicTextGap="12" maxWidth="Infinity" styleClass="nav-button">
            <graphic><FontIcon iconLiteral="mdi2c-cog-outline" iconSize="18" /></graphic>
        </Button>
    </VBox>

    <!-- Usuario en sesión -->
    <HBox styleClass="sidebar-footer">
        <StackPane styleClass="avatar">
            <Label styleClass="avatar-label" text="A" />
        </StackPane>
        <Label styleClass="sidebar-user-label" text="Usuario Administrador" />
    </HBox>
</VBox>

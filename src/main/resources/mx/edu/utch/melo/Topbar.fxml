<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Clúster de acciones común de la barra superior (cambiar usuario).
  Cada pantalla lo incluye al final de su propio <top> con
  <fx:include source="Topbar.fxml"/>, conservando su título, buscador
  o pestañas particulares fuera de este componente.

  El botón de notificaciones que vivía aquí se quitó (ver auditoría UI/UX,
  "qué quitar"): no tenía onAction en TopbarController, era un ícono decorativo
  presente en las 12 pantallas que incluyen este componente sin ninguna función
  detrás. Si algún día se implementan notificaciones reales, regresa aquí con
  su propio onAction, no antes.
-->
<HBox alignment="CENTER_LEFT" spacing="4"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.edu.utch.melo.controller.TopbarController">
    <Button fx:id="btnUsuario" styleClass="icon-button">
        <graphic><FontIcon iconLiteral="mdi2a-account-outline" iconSize="18" /></graphic>
        <tooltip><Tooltip text="Cambiar usuario" /></tooltip>
    </Button>
</HBox>
